# Copy to .env and fill in. .env is gitignored — never commit real keys.

# An RPC endpoint for the target network (Alchemy, Infura, or a public endpoint).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# A THROWAWAY deployer key funded with a little Sepolia ETH. Do not reuse a key
# that holds real funds.
PRIVATE_KEY=0xYOUR_TESTNET_DEPLOYER_PRIVATE_KEY

# From https://etherscan.io/myapikey — used for automatic source verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
